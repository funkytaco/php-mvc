.git
.gitignore
node_modules
.idea
.vscode
.DS_Store
docker-compose.yml
podman-compose.yml
*.log
# Generated/runtime state — never belongs in an image build context.
# (Dockerfile rm -rf's app/ anyway; excluding it stops local edits from
# busting the build cache. .installer/apps must STAY included — the build
# runs `composer nimbus:install` against it.)
app/
data/
html/
*-compose.yml
*-compose.dev.yml
coverage/
.phpunit.cache/
Containerfile.tools
bin/
# Secrets / templates the build never needs. .installer/apps/ and
# .installer/lkui/ must STAY included — nimbus:install / install-lkui
# read them in the builder stage (which is never shipped).
.installer/vault/
.installer/_templates/
*.md
debug-passwords.sh
# Host-side install marker. Shipping it makes the in-image installer
# refuse to run ("app.lock file exists").
src/.lock/
