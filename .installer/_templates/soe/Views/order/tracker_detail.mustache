<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order {{orderRef}} — Tracker</title>
    <link rel="stylesheet" href="/assets/css/soe.css">
    <script>
        // Auto-refresh every 15 seconds
        setInterval(function() {
            fetch('/api/orders/{{orderRef}}')
                .then(r => r.json())
                .then(d => {
                    if (d.success && d.data) {
                        // Update the DOM with new projection
                        updateTracker(d.data);
                    }
                })
                .catch(e => console.warn('Tracker refresh failed:', e));
        }, 15000);

        function updateTracker(projection) {
            // Update stage indicators
            document.querySelectorAll('[data-stage]').forEach(el => {
                const stage = el.getAttribute('data-stage');
                const state = projection.stages[stage] || 'pending';
                el.setAttribute('data-state', state);
            });

            // Update blocker if present
            const blockerEl = document.querySelector('.blocker-banner');
            if (projection.blocker) {
                blockerEl.style.display = 'flex';
                blockerEl.querySelector('[data-reason]').textContent = projection.blocker.reason;
                blockerEl.querySelector('[data-age]').textContent = projection.blocker.age;
            } else {
                blockerEl.style.display = 'none';
            }

            // Update elapsed time
            const elapsed = projection.elapsed.formatted;
            document.querySelector('[data-elapsed]').textContent = elapsed;
        }

        // Dev helper: advance the ticket to next stage
        function advanceTicket() {
            if (!confirm('Simulate advancing this ticket to the next queue?')) return;
            fetch('/order/{{orderRef}}/advance', { method: 'POST' })
                .then(r => r.json())
                .then(d => {
                    if (d.success) {
                        console.log(d.message);
                        // Refresh tracker immediately
                        location.reload();
                    } else {
                        alert('Error: ' + d.message);
                    }
                })
                .catch(e => alert('Advance failed: ' + e));
        }
    </script>
</head>
<body>
    <div class="container">
        <header class="header">
            <div class="header-top">
                <h1>Order Tracker</h1>
                <a href="/tracker" class="breadcrumb">← Back to orders</a>
            </div>
        </header>

        <main class="main">
            <!-- Blocker banner (if blocked) -->
            {{#blocker}}
            <div class="blocker-banner" data-state="blocked">
                <div class="blocker-icon">⚠️</div>
                <div class="blocker-content">
                    <strong data-reason>{{blocker.reason}}</strong>
                    <small>
                        Team: <em>{{blocker.team}}</em> · Blocked for <span data-age>{{blocker.age}}</span>
                    </small>
                </div>
            </div>
            {{/blocker}}

            <!-- Order header -->
            <div class="order-header">
                <div class="order-ref">
                    <span class="label">Order</span>
                    <span class="value monospace">{{orderRef}}</span>
                </div>
                <div class="app-name">
                    <span class="label">System</span>
                    <span class="value">{{appName}}</span>
                </div>
                <div class="status">
                    <span class="label">Status</span>
                    <span class="value status-chip" data-status="{{status}}">{{status}}</span>
                </div>
                <div class="elapsed">
                    <span class="label">Elapsed</span>
                    <span class="value" data-elapsed>{{elapsed.formatted}}</span>
                </div>
            </div>

            <!-- Stage stepper -->
            <div class="stage-stepper">
                <div class="stage" data-stage="Received" data-state="{{stages.Received}}">
                    <div class="stage-marker"></div>
                    <div class="stage-label">Received</div>
                </div>
                <div class="stage" data-stage="Provisioning" data-state="{{stages.Provisioning}}">
                    <div class="stage-marker"></div>
                    <div class="stage-label">Provisioning</div>
                </div>
                <div class="stage" data-stage="OS &amp; Hardening" data-state="{{stages['OS & Hardening']}}">
                    <div class="stage-marker"></div>
                    <div class="stage-label">OS &amp; Hardening</div>
                </div>
                <div class="stage" data-stage="Security Gates" data-state="{{stages['Security Gates']}}">
                    <div class="stage-marker"></div>
                    <div class="stage-label">Security Gates</div>
                </div>
                <div class="stage" data-stage="Build-out" data-state="{{stages['Build-out']}}">
                    <div class="stage-marker"></div>
                    <div class="stage-label">Build-out</div>
                </div>
                <div class="stage" data-stage="Evidence" data-state="{{stages.Evidence}}">
                    <div class="stage-marker"></div>
                    <div class="stage-label">Evidence</div>
                </div>
                <div class="stage" data-stage="Handover" data-state="{{stages.Handover}}">
                    <div class="stage-marker"></div>
                    <div class="stage-label">Handover</div>
                </div>
                <div class="stage" data-stage="Delivered" data-state="{{stages.Delivered}}">
                    <div class="stage-marker"></div>
                    <div class="stage-label">Delivered</div>
                </div>
            </div>

            {{#lanes}}
            <!-- Build-out parallel lanes -->
            <div class="buildout-lanes">
                <h3>Build-out Parallel Work</h3>
                <div class="lanes">
                    {{#lanes}}
                    <div class="lane" data-state="{{status}}">
                        <div class="lane-name">{{name}}</div>
                        <div class="lane-state">{{status}}</div>
                    </div>
                    {{/lanes}}
                </div>
            </div>
            {{/lanes}}

            <!-- Requirements Record -->
            <div class="requirements-card">
                <h3>Your Requirements</h3>
                <p class="requirements-text">{{requirementsRecord}}</p>
            </div>

            <!-- Dev actions (only in demo) -->
            <div class="dev-actions">
                <button onclick="advanceTicket()" class="btn btn-secondary">
                    [Dev] Simulate Next Step
                </button>
            </div>
        </main>

        <aside class="sidebar">
            <div class="order-summary">
                <h3>Order Summary</h3>
                <dl>
                    <dt>Order Ref</dt>
                    <dd class="monospace">{{orderRef}}</dd>
                    <dt>App</dt>
                    <dd>{{appName}}</dd>
                    <dt>Status</dt>
                    <dd>{{status}}</dd>
                    {{#needBy}}
                    <dt>Need By</dt>
                    <dd>{{needBy}}</dd>
                    {{/needBy}}
                </dl>
            </div>

            <div class="orders-list">
                <h3>Other Orders</h3>
                <ul class="order-nav">
                    {{#orders}}
                    <li>
                        <a href="/tracker/{{order_ref}}" class="{{#active}}active{{/active}}">
                            <span class="ref">{{order_ref}}</span>
                            <span class="app">{{app_name}}</span>
                        </a>
                    </li>
                    {{/orders}}
                </ul>
            </div>
        </aside>
    </div>
</body>
</html>
