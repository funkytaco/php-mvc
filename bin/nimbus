#!/usr/bin/env bash
#
# nimbus — all-in-one helper for the Nimbus PHP-MVC app generator.
#
# Host requirements: git, podman, and a compose provider (podman-compose or
# `podman compose`). PHP/Composer/Ansible are NOT needed on the host — the
# Nimbus engine runs inside the nimbus-tools container (UBI9 + PHP + Composer
# + ansible-core), operating on this repo via a bind mount.
#
# Two execution lanes:
#   Lane 1 (file-generating) — runs `composer nimbus:*` inside nimbus-tools.
#   Lane 2 (container lifecycle) — runs the compose provider directly on the
#   host with real exit-code handling (no podman-in-podman).
#
# macOS bash 3.2 compatible: no associative arrays, no ${var,,}.

set -u

NIMBUS_VERSION="1.0.0"
TOOLS_IMAGE="nimbus-tools:latest"

# Resolve repo root from this script's location (bin/..)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
HASH_FILE="$REPO_ROOT/.installer/.tools-image-hash"

COMPOSE_CMD=""   # set by preflight

# ---------------------------------------------------------------- output ----
c_info()  { printf '\033[1;37m[nimbus]\033[0m %s\n' "$1"; }
c_ok()    { printf '\033[1;32m[nimbus]\033[0m %s\n' "$1"; }
c_warn()  { printf '\033[1;33m[nimbus]\033[0m %s\n' "$1"; }
c_err()   { printf '\033[1;31m[nimbus]\033[0m %s\n' "$1" >&2; }
die()     { c_err "$1"; exit 1; }

# ------------------------------------------------------------- preflight ----
preflight() {
    command -v podman >/dev/null 2>&1 || die "podman not found. Install it first:
  macOS:  brew install podman && podman machine init && podman machine start
  RHEL:   sudo dnf install podman"

    # macOS: make sure the podman machine VM is up
    if [ "$(uname)" = "Darwin" ]; then
        if ! podman info >/dev/null 2>&1; then
            c_warn "podman machine is not running."
            printf 'Start it now? [Y/n] '
            read -r answer
            case "${answer:-Y}" in
                [Yy]*|"") podman machine start || die "podman machine failed to start" ;;
                *) die "podman machine must be running." ;;
            esac
        fi
    fi

    # Compose provider: prefer podman-compose, fall back to `podman compose`
    if command -v podman-compose >/dev/null 2>&1; then
        COMPOSE_CMD="podman-compose"
    elif podman compose version >/dev/null 2>&1; then
        COMPOSE_CMD="podman compose"
    else
        die "No compose provider found. Install one:
  macOS:  brew install podman-compose
  RHEL:   sudo dnf install podman-compose   (or: pip3 install podman-compose)"
    fi
}

# ----------------------------------------------------------- tools image ----
tools_hash() {
    cat "$REPO_ROOT/Containerfile.tools" "$REPO_ROOT/composer.json" 2>/dev/null | cksum | cut -d' ' -f1
}

ensure_tools_image() {
    current_hash="$(tools_hash)"
    stored_hash=""
    [ -f "$HASH_FILE" ] && stored_hash="$(cat "$HASH_FILE")"

    if ! podman image exists "$TOOLS_IMAGE" 2>/dev/null || [ "$current_hash" != "$stored_hash" ]; then
        c_info "Building nimbus-tools image (first run or definition changed) ..."
        podman build -f "$REPO_ROOT/Containerfile.tools" -t "$TOOLS_IMAGE" "$REPO_ROOT" \
            || die "Failed to build nimbus-tools image"
        mkdir -p "$(dirname "$HASH_FILE")"
        printf '%s' "$current_hash" > "$HASH_FILE"
        c_ok "nimbus-tools image ready."
    fi
}

# Allocate a TTY only when we actually have one (keeps CI/pipes working)
tty_flags() {
    if [ -t 0 ] && [ -t 1 ]; then printf '%s' "-it"; else printf '%s' "-i"; fi
}

run_tools() {
    # $@ = command to run inside the tools container, cwd /work = repo root
    podman run --rm "$(tty_flags)" \
        -v "$REPO_ROOT:/work:Z" -w /work \
        "$TOOLS_IMAGE" "$@"
}

ensure_vendor() {
    if [ ! -f "$REPO_ROOT/vendor/autoload.php" ]; then
        c_info "Installing framework dependencies (composer install, one-time) ..."
        run_tools composer install --no-interaction || die "composer install failed"
    fi
}

lane1() {
    # $1 = composer script name (without nimbus: prefix), rest = args
    script="$1"; shift
    ensure_tools_image
    ensure_vendor
    run_tools composer "nimbus:$script" -- "$@"
}

# ------------------------------------------------------------ lifecycle ----
compose_file() { printf '%s' "$REPO_ROOT/$1-compose.yml"; }
dev_file()     { printf '%s' "$REPO_ROOT/$1-compose.dev.yml"; }

require_app_arg() {
    [ -n "${1:-}" ] || die "App name required. Usage: nimbus $2 <app>"
    [ -f "$(compose_file "$1")" ] || die "No compose file for '$1'. Run: nimbus install $1"
}

app_url() {
    # Print app + optional dev URLs by reading app.nimbus.json (pure file I/O)
    run_tools php -r '
        $app = $argv[1];
        $cfg = json_decode(file_get_contents(".installer/apps/$app/app.nimbus.json"), true) ?: [];
        $port = $cfg["containers"]["app"]["port"] ?? "?";
        echo "App URL:         http://localhost:$port\n";
        if (!empty($cfg["containers"]["codeserver"]["port"]) && $argv[2] === "dev") {
            echo "code-server URL: http://localhost:" . $cfg["containers"]["codeserver"]["port"] . "\n";
            // The password is not printed: it grants a browser shell over the
            // app source, and for apps with a vault it is not in this file at
            // all (which is what used to render as "password: ?").
            $where = !empty($cfg["containers"]["codeserver"]["password"]) ? "config" : "vault-view";
            echo "code-server password: composer nimbus:$where $app\n";
        }
    ' "$1" "${2:-nodev}"
}

cmd_up() {
    app="${1:-}"; shift 2>/dev/null || true
    dev=""
    for a in "$@"; do [ "$a" = "--dev" ] && dev=1; done
    require_app_arg "$app" "up"

    files="-f $(compose_file "$app")"
    if [ -n "$dev" ]; then
        [ -f "$(dev_file "$app")" ] || lane1 dev "$app" || die "Failed to generate dev overlay"
        files="$files -f $(dev_file "$app")"
    fi

    # shellcheck disable=SC2086
    if $COMPOSE_CMD $files up --build -d; then
        c_ok "App '$app' is up."
        app_url "$app" "${dev:+dev}"
    else
        die "Failed to start '$app' (see output above)."
    fi
}

cmd_down() {
    app="${1:-}"; shift 2>/dev/null || true
    vols=""
    for a in "$@"; do [ "$a" = "--volumes" ] && vols="--volumes"; done
    require_app_arg "$app" "down"
    files="-f $(compose_file "$app")"
    [ -f "$(dev_file "$app")" ] && files="$files -f $(dev_file "$app")"
    # shellcheck disable=SC2086
    $COMPOSE_CMD $files down $vols || die "Failed to stop '$app'."
    c_ok "App '$app' is down."
}

cmd_status() {
    if [ -n "${1:-}" ]; then
        require_app_arg "$1" "status"
        $COMPOSE_CMD -f "$(compose_file "$1")" ps
    else
        found=""
        for f in "$REPO_ROOT"/*-compose.yml; do
            [ -e "$f" ] || continue
            found=1
            name="$(basename "$f" -compose.yml)"
            c_info "── $name ──"
            $COMPOSE_CMD -f "$f" ps
        done
        [ -n "$found" ] || c_info "No apps installed yet (no *-compose.yml files)."
    fi
}

cmd_rebuild() {
    require_app_arg "${1:-}" "rebuild"
    files="-f $(compose_file "$1")"
    [ -f "$(dev_file "$1")" ] && files="$files -f $(dev_file "$1")"
    # shellcheck disable=SC2086
    $COMPOSE_CMD $files up --build -d --force-recreate || die "Rebuild of '$1' failed."
    c_ok "App '$1' rebuilt."
}

cmd_logs() {
    require_app_arg "${1:-}" "logs"
    app="$1"; shift
    $COMPOSE_CMD -f "$(compose_file "$app")" logs -f "$@"
}

cmd_dev() {
    app="${1:-}"
    [ -n "$app" ] || die "App name required. Usage: nimbus dev <app>"
    [ -d "$REPO_ROOT/.installer/apps/$app" ] || die "App '$app' not found. Run: nimbus create $app"

    case "$REPO_ROOT" in
        "$HOME"*) : ;;
        *) c_warn "Repo is outside \$HOME — podman machine on macOS only auto-mounts \$HOME.
   If mounts fail: podman machine init -v $REPO_ROOT:$REPO_ROOT" ;;
    esac

    # Dev mode serves the app's OWN instance dir (.installer/apps/<app>) —
    # apps are isolated from each other, so no shared app/ juggling needed.
    # install is only required for its compose-file generation side effect.
    if [ ! -f "$(compose_file "$app")" ]; then
        lane1 install "$app" || die "install failed"
    fi
    # Generate/refresh the dev overlay, then bring the stack up with it
    lane1 dev "$app" || die "Failed to generate dev overlay"
    cmd_up "$app" --dev
}

cmd_init() {
    app="${1:-}"; shift 2>/dev/null || true
    [ -n "$app" ] || die "Usage: nimbus init <app> [template] [--no-db] [--dev]"
    dev=""
    args=""
    for a in "$@"; do
        case "$a" in
            --dev) dev=1 ;;
            *) args="$args $a" ;;
        esac
    done
    # shellcheck disable=SC2086
    lane1 create "$app" $args || die "create failed"
    lane1 install "$app" || die "install failed"
    if [ -n "$dev" ]; then
        cmd_dev "$app"
    else
        cmd_up "$app"
    fi
}

cmd_playbook() {
    [ -n "${1:-}" ] || die "Usage: nimbus playbook <playbook.yml> [ansible-playbook args...]"
    ensure_tools_image
    run_tools ansible-playbook "$@"
}

usage() {
    cat <<'EOF'
nimbus — Nimbus PHP-MVC app orchestrator (host needs only git + podman + compose)

App lifecycle (runs on host, honest exit codes):
  nimbus up <app> [--dev]        Start app stack (--dev: live-edit overlay)
  nimbus down <app> [--volumes]  Stop app stack
  nimbus status [app]            Show container status (all apps if omitted)
  nimbus rebuild <app>           Force rebuild + recreate
  nimbus logs <app> [service]    Follow container logs

Dev workflow:
  nimbus dev <app>               Generate dev overlay + up. Serves the app's
                                 own .installer/apps/<app>/ dir live-mounted —
                                 edit it locally or via code-server (VS Code in
                                 the browser); apps are isolated from each
                                 other, and edits survive installs/rebuilds.
  nimbus commit <app>            Copy this app's edits (Controllers/Models/
                                 Views/routes) from .installer/apps/<app>/ back
                                 to the shared template so future `create`
                                 runs include them. app.config.php is never
                                 committed (per-app resolved values).
  nimbus init <app> [template] [--no-db] [--dev]
                                 One-shot: create + install + up.

App management (runs in the nimbus-tools container):
  nimbus create <app> [template] [--no-db]
  nimbus create-with-eda <app> | create-eda-keycloak <app>
  nimbus create-from-git <app> <repo-url|repo-name> [--ref=<ref>]
                                 [--docroot=<dir>] [--containerfile=<path>]
                                 Containerize an app from a git repository
                                 (cloned into .installer/repos/). A repo can
                                 declare its own settings in .nimbus.json.
  nimbus install <app> | list | delete <app>
  nimbus add-eda | add-keycloak | add-eda-keycloak <app>
  nimbus remove-eda | remove-keycloak <app>
  nimbus template-scaffold <name> | template-check [name]
  nimbus alias-template | alias-remove | alias-list
  nimbus vault-init | vault-backup | vault-restore | vault-list | vault-view

Ansible:
  nimbus playbook <file> [args]  Run ansible-playbook inside nimbus-tools

Other:
  nimbus help | version

Note: `composer nimbus:*` still works if you have PHP+Composer locally
(legacy path; `bin/nimbus` is the recommended interface).
EOF
}

# ---------------------------------------------------------------- main -----
main() {
    cmd="${1:-help}"
    shift 2>/dev/null || true

    case "$cmd" in
        help|--help|-h) usage; exit 0 ;;
        version|--version) echo "nimbus $NIMBUS_VERSION"; exit 0 ;;
    esac

    preflight

    case "$cmd" in
        # Lane 2 — lifecycle on host
        up)       cmd_up "$@" ;;
        down)     cmd_down "$@" ;;
        status)   cmd_status "$@" ;;
        rebuild)  cmd_rebuild "$@" ;;
        logs)     cmd_logs "$@" ;;
        # Composite
        dev)      cmd_dev "$@" ;;
        init)     cmd_init "$@" ;;
        playbook) cmd_playbook "$@" ;;
        # Lane 1 — file-generating, via tools container
        create|create-with-eda|create-eda-keycloak|create-from-git|install|list|delete|\
        add-eda|add-keycloak|add-eda-keycloak|remove-eda|remove-keycloak|\
        commit|\
        template-scaffold|template-check|alias-template|alias-remove|alias-list|\
        vault-init|vault-backup|vault-restore|vault-list|vault-view)
            lane1 "$cmd" "$@" ;;
        *)
            c_err "Unknown command: $cmd"
            usage
            exit 1 ;;
    esac
}

main "$@"
